  <diagram id="page-architecture" name="Архитектура классов ООП">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="«Главный контейнер»&#xa;УмнаяТеплица (SmartGreenhouse)&#xa;──────────────────────────&#xa;- название : строка&#xa;- среда : СредаОбитания&#xa;- датчики : Датчик&lt;T&gt;&#xa;- журнал : ЖурналСобытий&#xa;- устройства : список Устройство*&#xa;──────────────────────────&#xa;+ подключитьУстройство()&#xa;+ выполнитьШаг()&#xa;+ задатьЦелевойКлимат()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="3" value="«Абстрактный базовый класс»&#xa;Устройство (Device)&#xa;──────────────────────────&#xa;# идентификатор : целое&#xa;# название : строка&#xa;# включено : логическое&#xa;──────────────────────────&#xa;+ обновить(среда)* : чисто вирт.&#xa;+ включить() / выключить()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="430" y="310" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="4" value="КлиматКонтроль&#xa;(ClimateController)&#xa;──────────────────────&#xa;- целеваяТемпература : дробн.&#xa;──────────────────────&#xa;+ обновить(среда) : переопр." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="100" y="530" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5" value="СистемаАвтополива&#xa;(IrrigationSystem)&#xa;──────────────────────&#xa;- целеваяВлажность : дробн.&#xa;──────────────────────&#xa;+ обновить(среда) : переопр." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="445" y="530" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Фитоосвещение&#xa;(LightingSystem)&#xa;──────────────────────&#xa;- минОсвещённость : целое&#xa;──────────────────────&#xa;+ обновить(среда) : переопр." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="790" y="530" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7" value="«Шаблонный класс»&#xa;Датчик&lt;T&gt; (Sensor&lt;T&gt;)&#xa;──────────────────────&#xa;- название : строка&#xa;- значение : T&#xa;──────────────────────&#xa;+ оператор &lt;, &gt;, ==&#xa;+ оператор &lt;&lt; (вывод)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="8" value="«Шаблонный класс»&#xa;ЖурналСобытий&lt;TСобытие&gt;&#xa;──────────────────────&#xa;- записи : вектор&lt;TСобытие&gt;&#xa;──────────────────────&#xa;+ добавитьСобытие()&#xa;+ вывестиВсе()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="280" height="150" as="geometry" />
